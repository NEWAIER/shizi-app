{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family.local/schemas/shizi-catalog-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "activePackId", "packs"],
  "properties": {
    "schemaVersion": {"const": 2},
    "activePackId": {"type": "string", "minLength": 1},
    "packs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pack"}}
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "version", "contentPath", "manifestPath", "assetRoot", "legacyCompatibleVersions"],
      "properties": {
        "packId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contentPath": {"type": "string", "pattern": "^content/(v1|packs/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)/content\\.json$"},
        "manifestPath": {"type": "string", "pattern": "^content/(v1|packs/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)/manifest\\.json$"},
        "assetRoot": {"type": "string", "pattern": "^content/(v1|packs/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)$"},
        "legacyCompatibleVersions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
