{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family.local/schemas/shizi-content-v1.schema.json",
  "title": "Shizi content package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "learningOrder", "reviewOffsetsDays", "optionCatalog", "characters"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "string", "minLength": 1},
    "course": {"$ref": "#/$defs/courseConfig"},
    "learningOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "reviewOffsetsDays": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "optionCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/optionContent"}
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/characterContent"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "audioPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^audio/(?!.*\\.\\.)(?!.*\\\\)[^:/\\\\]+(?:/[^:/\\\\]+)*\\.mp3$"
    },
    "imagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^images/(?!.*\\.\\.)(?!.*\\\\)[^:/\\\\]+(?:/[^:/\\\\]+)*\\.webp$"
    },
    "optionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "characterId"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"enum": ["TEXT", "IMAGE", "AUDIO", "CONTEXT"]},
        "characterId": {"$ref": "#/$defs/nonEmptyString"},
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "asset": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "TEXT"}}, "required": ["text"], "not": {"required": ["asset"]}},
        {"properties": {"kind": {"const": "IMAGE"}, "asset": {"$ref": "#/$defs/imagePath"}}, "required": ["asset"]},
        {"properties": {"kind": {"const": "AUDIO"}, "asset": {"$ref": "#/$defs/audioPath"}}, "required": ["asset"]},
        {"properties": {"kind": {"const": "CONTEXT"}, "asset": {"$ref": "#/$defs/imagePath"}}, "required": ["text", "asset"]}
      ]
    },
    "wordContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "audioAsset"],
      "properties": {
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "audioAsset": {"$ref": "#/$defs/audioPath"}
      }
    },
    "sentenceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "audioAsset"],
      "properties": {
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "audioAsset": {"$ref": "#/$defs/audioPath"}
      }
    },
    "audioRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "meaning"],
      "properties": {
        "character": {"$ref": "#/$defs/audioPath"},
        "meaning": {"$ref": "#/$defs/audioPath"}
      }
    },
    "readingContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinyin", "toneNumber"],
      "properties": {
        "pinyin": {"$ref": "#/$defs/nonEmptyString"},
        "toneNumber": {"type": "integer", "minimum": 1, "maximum": 4},
        "audioAsset": {"$ref": "#/$defs/audioPath"}
      }
    },
    "badgeMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "learnedCount", "title", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "learnedCount": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "detail": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "courseConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageTestThreshold", "badgeMilestones"],
      "properties": {
        "stageTestThreshold": {"type": "integer", "minimum": 1},
        "badgeMilestones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/badgeMilestone"}}
      }
    },
    "questionSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "promptAudio", "correctOptionId", "optionIds", "minLearnedCount", "evidenceCategory"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"enum": ["CHARACTER_CHOOSE_IMAGE", "LISTEN_CHOOSE_CHARACTER", "CHARACTER_CHOOSE_AUDIO", "SHAPE_RECOGNITION", "LIFE_WORD_CONTEXT"]},
        "promptAudio": {"$ref": "#/$defs/audioPath"},
        "correctOptionId": {"$ref": "#/$defs/nonEmptyString"},
        "optionIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "minLearnedCount": {"type": "integer", "minimum": 0},
        "evidenceCategory": {"enum": ["SHAPE_TO_MEANING", "SOUND_TO_SHAPE", "SHAPE_TO_SOUND", "SHAPE", "CONTEXT"]}
      }
    },
    "contentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textReviewed", "assetReviewedByDeveloper", "assetReviewedByParent", "blockedReason"],
      "properties": {
        "textReviewed": {"type": "boolean"},
        "assetReviewedByDeveloper": {"type": "boolean"},
        "assetReviewedByParent": {"type": "boolean"},
        "blockedReason": {"oneOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "null"}]}
      }
    },
    "characterContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "character", "pinyin", "toneNumber", "order", "meaningForChild", "imageAsset", "imageAlt", "words", "sentence", "audio", "teachingPrompt", "confusableRestrictions", "misconceptions", "questionSeeds", "contentReview"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "character": {"$ref": "#/$defs/nonEmptyString"},
        "pinyin": {"$ref": "#/$defs/nonEmptyString"},
        "toneNumber": {"type": "integer", "minimum": 1, "maximum": 4},
        "readings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/readingContent"}},
        "order": {"type": "integer", "minimum": 1},
        "meaningForChild": {"$ref": "#/$defs/nonEmptyString"},
        "imageAsset": {"$ref": "#/$defs/imagePath"},
        "imageAlt": {"$ref": "#/$defs/nonEmptyString"},
        "words": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/wordContent"}},
        "sentence": {"$ref": "#/$defs/sentenceContent"},
        "audio": {"$ref": "#/$defs/audioRefs"},
        "teachingPrompt": {"$ref": "#/$defs/nonEmptyString"},
        "confusableRestrictions": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "misconceptions": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "questionSeeds": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/questionSeed"}},
        "contentReview": {"$ref": "#/$defs/contentReview"}
      }
    }
  }
}
